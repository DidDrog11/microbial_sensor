# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site (scoped: the project's docs/ tree is version-controlled)
/docs/pkgdown/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# --- Project-specific ---------------------------------------------------

# Raw data is read-only and never committed (see CLAUDE.md)
data-raw/

# Processed data: keep the directory tree, not the objects
data/**
!data/**/
!data/**/README.md

# Large / binary data formats, wherever they appear
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.sam
*.vcf
*.vcf.gz
*.rds
*.RDS
*.rda
*.qs
*.feather
*.parquet
*.sqlite
*.duckdb

# Credentials
.env
*.pem
*.key
credentials.json
secrets.yml

# Quarto
.quarto/
_freeze/
**/_output/
**/*_files/
**/*.knit.md
**/*.utf8.md
/docs/**/*.tex
!/docs/**/preamble.tex
/docs/**/*.log

# renv: renv/.gitignore (committed, managed by renv) excludes the project
# library. renv.lock, renv/activate.R and .Rprofile are tracked.

# macOS / Windows cruft
.DS_Store
Thumbs.db
