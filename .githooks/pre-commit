#!/bin/sh
# Block commits that add or change a file larger than 50 MB.
#
# GitHub warns at 50 MB and refuses pushes with any blob over 100 MB. Raw
# data in this repository is tracked deliberately (see .gitignore), so the
# size guard lives here rather than in ignore rules, which cannot see sizes.
#
# Enable once per clone:  git config core.hooksPath .githooks

limit_mb=50
limit=$((limit_mb * 1024 * 1024))
status=0

for f in $(git diff --cached --name-only --diff-filter=AM); do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f")
  if [ "$size" -gt "$limit" ]; then
    echo "pre-commit: $f is $((size / 1024 / 1024)) MB, over the ${limit_mb} MB limit" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-commit: unstage the file(s) above, or add them to .gitignore" >&2
fi
exit $status
